<%- include('partials/header') %>

<div class="admin-layout-container" style="padding-top: 40px; padding-bottom: 60px;">
  <div class="container">
    <div style="margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
      <div>
        <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 8px;">Admin Assessment Control</h1>
        <p style="color: var(--text-secondary);">Manage company roles and evaluate candidate AI fitment reports.</p>
      </div>
      <button class="btn btn-primary" onclick="openCreateModal()">Create Interview</button>
    </div>

    <!-- Main Grid -->
    <div class="admin-grid" style="display: grid; grid-template-columns: 320px 1fr; gap: 30px;">
      
      <!-- Left Column: Role list -->
      <div>
        <h3 style="font-size: 1.1rem; margin-bottom: 16px;">Job Roles</h3>
        <div id="interview-list" style="display: flex; flex-direction: column; gap: 12px;">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Right Column: Candidates list -->
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
          <h3 style="font-size: 1.1rem;"><span id="list-title">All Candidates</span></h3>
          
          <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <input type="text" id="search-input" class="input" placeholder="Search by name/email" style="max-width: 200px; padding: 6px 12px;" oninput="applyFilters()" />
            <select id="decision-filter" class="select" style="max-width: 150px; padding: 6px 12px;" onchange="applyFilters()">
              <option value="">All Decisions</option>
              <option value="Shortlisted">Shortlisted</option>
              <option value="Under Review">Under Review</option>
              <option value="Not Fit">Not Fit</option>
              <option value="Pending">Pending</option>
            </select>
          </div>
        </div>

        <div id="candidates-loading" class="spinner" style="margin: 20px auto;"></div>
        <div id="candidates-empty" style="display: none; background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 40px; text-align: center;">
          <p style="color: var(--text-muted); margin: 0;">No candidates matching the criteria.</p>
        </div>

        <div class="card" id="candidates-table-container" style="display: none; overflow-x: auto;">
          <table class="table" id="candidates-table">
            <thead>
              <tr>
                <th>Candidate</th>
                <th>Applied Role</th>
                <th>Overall Score</th>
                <th>Trust Score</th>
                <th>Decision</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="candidates-tbody">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Candidate Details Modal -->
<div id="candidate-modal" class="modal-overlay" style="display: none;">
  <div class="modal-content" style="max-width: 780px;">
    <div class="modal-header">
      <h3 style="margin: 0;" id="cand-detail-name">Candidate Evaluation</h3>
      <button class="btn btn-ghost btn-sm" onclick="closeCandidateModal()" style="padding: 4px 8px;">✕</button>
    </div>
    <div class="modal-body" style="gap: 20px;">
      <div style="display: grid; grid-template-columns: 1fr 320px; gap: 24px;" id="cand-modal-grid">
        <!-- Details & Transcript -->
        <div>
          <div style="margin-bottom: 20px;">
            <p><b>Email:</b> <span id="cand-detail-email"></span></p>
            <p><b>Language:</b> <span id="cand-detail-lang"></span></p>
            <p><b>Trust Alerts:</b> <span id="cand-detail-alerts"></span></p>
          </div>
          
          <h4 style="margin-bottom: 12px;">Answer Transcript Review</h4>
          <div style="max-height: 320px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; border: 1px solid var(--border); padding: 12px; border-radius: 8px;" id="cand-answers-list">
            <!-- Populated dynamically -->
          </div>
        </div>

        <!-- Charts & Decision Control -->
        <div>
          <div style="max-width: 240px; margin: 0 auto 20px;">
            <canvas id="candRadarChart"></canvas>
          </div>

          <div style="border-top: 1px solid var(--border); padding-top: 20px;">
            <h4 style="margin-bottom: 12px;">Fitment Update</h4>
            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px;">
              <button class="btn btn-emerald" onclick="updateFitment('Shortlisted')" style="justify-content: center; background: #059669; border: none; color: #fff;">Shortlist</button>
              <button class="btn btn-outline" onclick="updateFitment('Under Review')" style="justify-content: center; border-color: var(--amber);">Under Review</button>
              <button class="btn btn-danger" onclick="updateFitment('Not Fit')" style="justify-content: center; background: #EF4444; border: none; color: #fff;">Mark Not Fit</button>
            </div>
            <textarea id="admin-notes" class="textarea" placeholder="Add optional evaluator notes..." rows="3"></textarea>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="closeCandidateModal()">Close Details</button>
    </div>
  </div>
</div>

<!-- Create Interview Modal -->
<div id="create-modal" class="modal-overlay" style="display: none;">
  <div class="modal-content" style="max-width: 500px;">
    <div class="modal-header">
      <h3 style="margin: 0;">Create New Assessment Role</h3>
      <button class="btn btn-ghost btn-sm" onclick="closeCreateModal()" style="padding: 4px 8px;">✕</button>
    </div>
    <div class="modal-body">
      <form id="create-interview-form">
        <div style="margin-bottom: 16px;">
          <label class="label">Company Name</label>
          <input type="text" id="new-company" class="input" value="HireVaani" required />
        </div>
        <div style="margin-bottom: 16px;">
          <label class="label">Role (Designation)</label>
          <select id="new-role" class="select" required>
            <option value="">Select a role</option>
            <option value="software_engineer">Software Engineer</option>
            <option value="data_analyst">Data Analyst</option>
            <option value="marketing_executive">Marketing Executive</option>
            <option value="hr_executive">HR Executive</option>
            <option value="sales_executive">Sales Executive</option>
            <option value="customer_support">Customer Support</option>
          </select>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
          <div>
            <label class="label">Start Date</label>
            <input type="date" id="new-start" class="input" required />
          </div>
          <div>
            <label class="label">End Date</label>
            <input type="date" id="new-end" class="input" required />
          </div>
        </div>
        <div style="margin-bottom: 16px;">
          <label class="label">Job Description</label>
          <textarea id="new-desc" class="textarea" placeholder="Provide detail role description..." required rows="3"></textarea>
        </div>
        <div style="margin-bottom: 16px;">
          <label class="label">Interview Instructions</label>
          <textarea id="new-instructions" class="textarea" required rows="2">Please ensure you are in a quiet room with good lighting.</textarea>
        </div>
        <div id="create-error" class="alert alert-error" style="display: none; margin-bottom: 16px;"></div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="closeCreateModal()">Cancel</button>
      <button class="btn btn-primary" onclick="submitCreateForm()" id="create-submit-btn">Create Role</button>
    </div>
  </div>
</div>

<div id="toast-notif" class="toast" style="display: none;"></div>

<style>
  .admin-layout-container { min-height: calc(100vh - 168px); }
  @media (max-width: 850px) {
    .admin-grid { grid-template-columns: 1fr !important; }
    #cand-modal-grid { grid-template-columns: 1fr !important; }
  }
</style>

<script>
  const ROLE_LABELS = {
    software_engineer: 'Software Engineer', data_analyst: 'Data Analyst',
    marketing_executive: 'Marketing Executive', hr_executive: 'HR Executive',
    sales_executive: 'Sales Executive', customer_support: 'Customer Support',
  };

  const DECISION_CLASSES = {
    Shortlisted: 'badge-emerald',
    'Under Review': 'badge-amber',
    'Not Fit': 'badge-rose',
    Pending: 'badge-gray'
  };

  let token = '';
  let candidates = [];
  let interviews = [];
  let selectedInterviewRole = null; // Drill down role filter
  let currentCandidateSessionId = null; // Currently opened candidate in modal
  let candChartInstance = null; // Radar chart instance

  // Set default dates for create form
  document.getElementById('new-start').value = new Date().toISOString().split('T')[0];
  document.getElementById('new-end').value = new Date(Date.now() + 86400000).toISOString().split('T')[0];

  (async function init() {
    token = localStorage.getItem('hv_token');
    const userStr = localStorage.getItem('hv_user');
    
    if (!token || !userStr) {
      window.location.href = '/login';
      return;
    }

    try {
      const user = JSON.parse(userStr);
      if (user.role !== 'organizer') {
        window.location.href = '/dashboard';
        return;
      }
      
      await fetchAdminData();
    } catch (e) {
      window.location.href = '/login';
    }
  })();

  async function fetchAdminData() {
    try {
      const headers = { 'Authorization': `Bearer ${token}` };
      const [resCands, resIvs] = await Promise.all([
        fetch('/api/candidates', { headers }).then(r => r.json()),
        fetch('/api/interviews', { headers }).then(r => r.json())
      ]);

      candidates = resCands.candidates || [];
      interviews = resIvs || [];

      renderInterviews();
      applyFilters();
    } catch (e) {
      console.error(e);
      showToast('Failed to load data');
    }
  }

  function showToast(msg) {
    const toast = document.getElementById('toast-notif');
    toast.innerText = msg;
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; }, 3000);
  }

  function renderInterviews() {
    const list = document.getElementById('interview-list');
    
    list.innerHTML = `
      <div class="card" style="padding: 14px 18px; cursor: pointer; border-color: ${selectedInterviewRole === null ? 'var(--brand-primary)' : 'var(--border)'}; background: ${selectedInterviewRole === null ? 'var(--bg-hover)' : '#fff'};" onclick="selectInterviewRole(null)">
        <h4 style="margin: 0;">Show All Candidates</h4>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Total candidates: ${candidates.length}</p>
      </div>
    ` + interviews.map(iv => {
      const active = selectedInterviewRole === iv.role;
      const roleCandidates = candidates.filter(c => c.role === iv.role);
      
      return `
        <div class="card" style="padding: 14px 18px; cursor: pointer; border-color: ${active ? 'var(--brand-primary)' : 'var(--border)'}; background: ${active ? 'var(--bg-hover)' : '#fff'};" onclick="selectInterviewRole('${iv.role}')">
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <h4 style="margin: 0; font-size: 0.95rem;">${ROLE_LABELS[iv.role] || iv.role}</h4>
            <button class="btn btn-ghost btn-sm" style="padding: 2px 6px; color: var(--rose);" onclick="deleteInterview(event, '${iv.id || iv._id}')">✕</button>
          </div>
          <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Candidates: ${roleCandidates.length}</p>
        </div>
      `;
    }).join('');
  }

  function selectInterviewRole(role) {
    selectedInterviewRole = role;
    document.getElementById('list-title').innerText = role ? `Candidates for ${ROLE_LABELS[role] || role}` : 'All Candidates';
    renderInterviews();
    applyFilters();
  }

  async function deleteInterview(event, id) {
    event.stopPropagation();
    if (!confirm('Are you sure you want to delete this interview role?')) return;
    
    try {
      const response = await fetch(`/api/interviews/${id}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!response.ok) throw new Error('Delete failed');
      showToast('Interview deleted');
      await fetchAdminData();
    } catch (e) {
      showToast(e.message);
    }
  }

  function applyFilters() {
    const s = document.getElementById('search-input').value.toLowerCase();
    const d = document.getElementById('decision-filter').value;
    
    const filtered = candidates.filter(c => {
      const matchRole = !selectedInterviewRole || c.role === selectedInterviewRole;
      const matchSearch = c.name.toLowerCase().includes(s) || (c.email && c.email.toLowerCase().includes(s));
      const matchDecision = !d || c.fitmentDecision === d;
      return matchRole && matchSearch && matchDecision;
    });

    document.getElementById('candidates-loading').style.display = 'none';
    if (filtered.length === 0) {
      document.getElementById('candidates-table-container').style.display = 'none';
      document.getElementById('candidates-empty').style.display = 'block';
    } else {
      document.getElementById('candidates-empty').style.display = 'none';
      document.getElementById('candidates-table-container').style.display = 'block';
      
      const tbody = document.getElementById('candidates-tbody');
      tbody.innerHTML = filtered.map(c => `
        <tr>
          <td>
            <div style="font-weight: 600;">${c.name}</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">${c.email}</div>
          </td>
          <td>${ROLE_LABELS[c.role] || c.role}</td>
          <td><b style="font-size: 0.95rem;">${c.overallScore || '—'}</b>/10</td>
          <td>${c.trustScore || '—'}%</td>
          <td><span class="badge ${DECISION_CLASSES[c.fitmentDecision || 'Pending']}">${c.fitmentDecision || 'Pending'}</span></td>
          <td>
            <button class="btn btn-outline btn-sm" onclick="openCandidateModal('${c.sessionId}')">Review Report</button>
          </td>
        </tr>
      `).join('');
    }
  }

  window.openCandidateModal = async function(sessionId) {
    currentCandidateSessionId = sessionId;
    
    // Clear dynamic content
    document.getElementById('cand-answers-list').innerHTML = '<div class="spinner"></div>';
    document.getElementById('candidate-modal').style.display = 'flex';

    try {
      const response = await fetch(`/api/candidates/${sessionId}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Failed to fetch candidate details.');

      document.getElementById('cand-detail-name').innerText = `${data.name} - Report`;
      document.getElementById('cand-detail-email').innerText = data.email || '—';
      document.getElementById('cand-detail-lang').innerText = data.language || 'English';
      document.getElementById('cand-detail-alerts').innerText = data.faceAlerts || 0;
      document.getElementById('admin-notes').value = data.adminNotes || '';

      // Populate answers list
      document.getElementById('cand-answers-list').innerHTML = data.answers.map((ans, idx) => `
        <div style="padding: 10px; border-radius: 6px; background: var(--bg-secondary); border: 1px solid var(--border);">
          <div style="font-size: 0.75rem; font-weight: bold; margin-bottom: 4px;">Q${idx + 1}: ${ans.questionText}</div>
          <div style="font-size: 0.8rem; padding: 6px; background: #fff; border: 1px solid var(--border); border-radius: 4px;">
            ${ans.transcript || 'No transcript'}
          </div>
          ${(ans.geminiScores && ans.geminiScores.feedback) ? `
            <div style="font-size: 0.75rem; color: #166534; margin-top: 4px;">
              <b>AI Feedback:</b> ${ans.geminiScores.feedback}
            </div>
          ` : ''}
        </div>
      `).join('');

      // Populate Radar Chart
      const scores = data.skillScores || {};
      renderCandRadar([
        scores.relevance || 0,
        scores.clarity || 0,
        scores.confidence || 0,
        scores.technical || 0,
        scores.communication || 0
      ]);

    } catch (e) {
      alert(e.message);
      closeCandidateModal();
    }
  }

  function renderCandRadar(skills) {
    const canvas = document.getElementById('candRadarChart');
    const ctx = canvas.getContext('2d');
    
    if (candChartInstance) {
      candChartInstance.destroy();
    }

    candChartInstance = new Chart(ctx, {
      type: 'radar',
      data: {
        labels: ['Relevance', 'Clarity', 'Confidence', 'Technical', 'Communication'],
        datasets: [{
          data: skills,
          backgroundColor: 'rgba(17,24,39,0.08)',
          borderColor: '#111827',
          pointBackgroundColor: '#111827',
          pointBorderColor: '#fff',
          pointRadius: 4,
          borderWidth: 2,
          fill: true,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        scales: {
          r: {
            min: 0,
            max: 10,
            ticks: { stepSize: 2, display: false },
            grid: { color: '#e5e7eb' },
            pointLabels: { font: { size: 9 } }
          }
        },
        plugins: { legend: { display: false } }
      }
    });
  }

  window.closeCandidateModal = function() {
    document.getElementById('candidate-modal').style.display = 'none';
  }

  window.updateFitment = async function(decision) {
    const notes = document.getElementById('admin-notes').value;
    try {
      const response = await fetch(`/api/candidates/${currentCandidateSessionId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ fitmentDecision: decision, adminNotes: notes })
      });
      if (!response.ok) throw new Error('Update failed');
      
      showToast(`Fitment updated to ${decision}`);
      closeCandidateModal();
      await fetchAdminData();
    } catch (e) {
      showToast(e.message);
    }
  }

  window.openCreateModal = function() {
    document.getElementById('create-modal').style.display = 'flex';
  }

  window.closeCreateModal = function() {
    document.getElementById('create-modal').style.display = 'none';
  }

  window.submitCreateForm = async function() {
    const companyName = document.getElementById('new-company').value.trim();
    const role = document.getElementById('new-role').value;
    const startDate = document.getElementById('new-start').value;
    const endDate = document.getElementById('new-end').value;
    const description = document.getElementById('new-desc').value.trim();
    const instructions = document.getElementById('new-instructions').value.trim();
    
    const errEl = document.getElementById('create-error');
    const submitBtn = document.getElementById('create-submit-btn');

    if (!role || !companyName || !startDate || !endDate || !description) {
      errEl.innerText = 'All fields are required.';
      errEl.style.display = 'block';
      return;
    }

    errEl.style.display = 'none';
    submitBtn.disabled = true;
    submitBtn.innerText = 'Creating...';

    try {
      const response = await fetch('/api/interviews', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ companyName, role, startDate, endDate, description, instructions })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.message || 'Failed to create assessment.');

      showToast('Interview assessment created');
      closeCreateModal();
      await fetchAdminData();
    } catch (e) {
      errEl.innerText = e.message;
      errEl.style.display = 'block';
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = 'Create Role';
    }
  }
</script>

<%- include('partials/footer') %>
